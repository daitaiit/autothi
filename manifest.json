{
  "manifest_version": 3,
  "name": "AutoThi AI - Trợ Lý Tự Động Làm Bài Thi & Trắc Nghiệm",
  "version": "1.0.0",
  "author": "Đại Tài",
  "homepage_url": "https://github.com/daitaiit/autothi",
  "description": "Tự động phân tích, giải đề và chọn đáp án trắc nghiệm chính xác bằng AI & Ngân hàng đề thông minh. Phát triển bởi Đại Tài.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "scripts/content.js"
      ],
      "css": [
        "scripts/content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["contests_manifest.json"],
      "matches": ["<all_urls>"]
    }
  ]
}